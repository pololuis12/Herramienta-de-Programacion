<?xml version="1.0" encoding="utf-8"?>
<!-- Resalta la fila activa de una lista de selección única. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/beige" android:state_activated="true" />
    <item android:drawable="@color/beige" android:state_pressed="true" />
    <item android:drawable="@android:color/transparent" />
</selector>
