<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFotosTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Galería de fotos"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvContadorFotos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brown" />

    <Button
        android:id="@+id/btnAgregarFotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/green"
        android:text="Agregar fotos"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnVolverPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/brown"
        android:text="Volver al perfil"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tvSinFotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Aún no hay fotos. Toca «Agregar fotos» para elegir imágenes de tu galería."
        android:visibility="gone" />

    <GridView
        android:id="@+id/gvFotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:horizontalSpacing="6dp"
        android:numColumns="2"
        android:stretchMode="columnWidth"
        android:verticalSpacing="6dp" />

</LinearLayout>
