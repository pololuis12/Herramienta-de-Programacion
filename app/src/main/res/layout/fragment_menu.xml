<?xml version="1.0" encoding="utf-8"?>
<!-- Fragmento izquierdo: menú permanente de la aplicación. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btnPerfil"
            style="@style/DogCare.BotonMenu"
            android:text="Perfil" />

        <Button
            android:id="@+id/btnFotos"
            style="@style/DogCare.BotonMenu"
            android:text="Fotos" />

        <Button
            android:id="@+id/btnVideo"
            style="@style/DogCare.BotonMenu"
            android:text="Video" />

        <Button
            android:id="@+id/btnWeb"
            style="@style/DogCare.BotonMenu"
            android:text="Web" />

        <Button
            android:id="@+id/btnBotones"
            style="@style/DogCare.BotonMenu"
            android:text="Botones" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Clínica"
            android:textColor="@color/brown"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnServicios"
            style="@style/DogCare.BotonMenu"
            android:backgroundTint="@color/brown"
            android:text="Servicios" />

        <Button
            android:id="@+id/btnCitas"
            style="@style/DogCare.BotonMenu"
            android:backgroundTint="@color/brown"
            android:text="Citas" />

    </LinearLayout>
</ScrollView>
